DJANGO_SECRET_KEY=replace-with-a-random-50-character-secret-key-before-use
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],identityforge.local

DATABASE_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=identityforge
DB_PASSWORD=change-this-database-password
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=prefer

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

API_THROTTLE_ANON=20/min
API_THROTTLE_USER=240/min
SYNTHETIC_DATA_ONLY=True
HIGH_RISK_PERMISSION_LIMIT=3
INACTIVE_ACCOUNT_DAYS=30
REVIEW_OVERDUE_DAYS=7
SESSION_TIMEOUT_LIMIT_MINUTES=60
ANOMALY_CONTAMINATION=0.12
ANOMALY_MIN_SAMPLES=8
LOG_LEVEL=INFO
